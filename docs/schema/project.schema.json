{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vxnishhhhh/mtdi-studio-/docs/schema/project.schema.json",
  "title": "MTDI 5.0 project manifest",
  "description": "One project.json per project. Authoritative validation is mtdi/project.py (python -m mtdi check).",
  "type": "object",
  "required": [
    "project",
    "sources",
    "channels"
  ],
  "properties": {
    "mtdi": {
      "type": "string",
      "default": "5.0"
    },
    "project": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9\\-]{0,47}$"
        },
        "name": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "[[term]] highlights a technical term"
        }
      }
    },
    "hardware": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "adapter"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "adapter": {
            "enum": [
              "http",
              "process",
              "python",
              "replay",
              "serial",
              "simulator",
              "system",
              "tcp"
            ]
          },
          "port": {
            "type": "string"
          },
          "baud": {
            "type": "integer"
          },
          "vid": {
            "type": [
              "string",
              "integer"
            ]
          },
          "listen": {
            "type": "string"
          },
          "connect": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object"
          },
          "restart_after": {
            "type": "number"
          },
          "callable": {
            "type": "string"
          },
          "options": {
            "type": "object"
          },
          "file": {
            "type": "string"
          },
          "loop": {
            "type": "boolean"
          },
          "speed": {
            "type": "number"
          },
          "from_source": {
            "type": "string"
          },
          "interval": {
            "type": "number"
          },
          "disk": {
            "type": "string"
          },
          "rate": {
            "type": "number"
          },
          "seed": {
            "type": "integer"
          },
          "data_source": {
            "enum": [
              "HARDWARE",
              "SOFTWARE",
              "REPLAY"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "keys"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.\\-]{0,47}$"
            }
          },
          "kind": {
            "enum": [
              "scalar",
              "vector"
            ]
          },
          "axes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "domain": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_\\-]{0,31}$",
            "examples": [
              "acoustic",
              "biomedical",
              "chemical",
              "compute",
              "energy",
              "environmental",
              "generic",
              "inertial",
              "motion",
              "network",
              "optical",
              "power",
              "pressure",
              "radio",
              "security",
              "software",
              "thermal",
              "ultrasonic"
            ]
          },
          "physical": {
            "type": "string",
            "description": "alias of domain"
          },
          "unit": {
            "type": "string"
          },
          "scale": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ]
          },
          "offset": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ]
          },
          "raw_range": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "transform": {
            "enum": [
              "ac_rms",
              "none"
            ]
          },
          "window": {
            "type": "integer",
            "minimum": 2
          },
          "noise_floor": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "noise_budget": {
            "type": "number"
          },
          "expected_rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "stale_after": {
            "type": "number"
          },
          "alert_change": {
            "type": "number"
          },
          "optional": {
            "type": "boolean"
          },
          "calibration": {
            "description": "Scalar channels only. true = gain*value + offset + temp_coeff*(T - temp_ref), applied after scale/offset. An object, or a path (relative to the project folder) to a file saved by mtdi.fusion.Calibration.save.",
            "oneOf": [
              {"type": "string"},
              {"type": "object", "properties": {
                "gain": {"type": "number"}, "offset": {"type": "number"},
                "temp_coeff": {"type": "number"}, "temp_ref": {"type": "number"},
                "temperature_key": {"type": "string"},
                "residual_sd": {"type": ["number", "null"], "minimum": 0}, "method": {"type": "string"}, "n": {"type": "integer", "minimum": 0}},
                "additionalProperties": false}
            ]
          },
          "accent": {
            "type": "string"
          },
          "simulate": {
            "type": "object",
            "properties": {
              "mean": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              },
              "noise": {
                "type": "number"
              },
              "wave": {
                "type": "object",
                "properties": {
                  "amp": {
                    "type": "number"
                  },
                  "hz": {
                    "type": "number"
                  }
                }
              },
              "events": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "window": {
          "type": "number"
        },
        "auto_relock_after": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "weights": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "availability",
          "baseline",
          "signal_to_noise",
          "clipping",
          "timing",
          "transient",
          "axial_consensus",
          "correlation"
        ]
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "nvtra": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when",
              "condition"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "when": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "integer"
                  ],
                  "pattern": "^\\s*(>=|<=|==|>|<)\\s*-?\\d+(\\.\\d+)?\\s*$"
                }
              },
              "condition": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "aether": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string"
        },
        "story": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authorship": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "interface": {
      "type": "object",
      "description": "reserved; ignored by MTDI 5.0 (the studio is configured through \"studio\")"
    },
    "studio": {
      "type": "object",
      "description": "Which channels fill the studio's display channels (ch1 vector or number, ch2 number, ch3 sweep). Default: the first three channels.",
      "properties": {
        "ch1": {
          "type": "string",
          "description": "a channel id"
        },
        "ch2": {
          "type": "string",
          "description": "a channel id"
        },
        "ch3": {
          "type": "string",
          "description": "a channel id"
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "enum": [
        "edge",
        "scientific",
        "vision",
        "autonomous",
        "hybrid",
        "research"
      ],
      "default": "hybrid",
      "description": "Intelligence Profile (ADR 0006): which modules load and the smallest host that may run it."
    }
  }
}
