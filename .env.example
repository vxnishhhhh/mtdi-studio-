# Integrations used by `python -m mtdi create` and `python -m mtdi publish`.
# Copy to your shell profile (export NAME=value). Never commit real values.
GITHUB_TOKEN=          # or sign in with `gh auth login` instead
VERCEL_TOKEN=          # https://vercel.com/account/tokens
VERCEL_TEAM_ID=        # only for a Vercel team
NOTION_TOKEN=          # an internal integration: https://www.notion.so/my-integrations
NOTION_PARENT_PAGE_ID= # a page shared with that integration (32-character id from its URL)
