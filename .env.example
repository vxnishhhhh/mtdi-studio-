# MTDI 5.0 configuration. Every value is read from the environment only and never written
# to disk by MTDI. Locally: export NAME=value in your shell. On Vercel: Project → Settings →
# Environment Variables. Never commit real values.

# ── NVTRA intelligence (any one is enough; first found wins unless MTDI_LLM_PROVIDER is set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=            # also enables voice input (Whisper large v3)
XAI_API_KEY=
MTDI_LLM_PROVIDER=       # anthropic | openai | gemini | groq | xai
MTDI_LLM_MODEL=          # override the provider's default model

# ── Voice
ELEVENLABS_API_KEY=      # NVTRA's spoken voice (OpenAI TTS is used if only OPENAI_API_KEY is set)
MTDI_ELEVENLABS_VOICE=   # optional voice id

# ── Studio (the interface)
STUDIO_INGEST_TOKEN=     # required on a public deployment for POST /api/ingest
STUDIO_SECRET_KEY=       # fixed session secret (any long random string)

# ── Cloud storage (S3, Cloudflare R2, MinIO, Backblaze B2: requests are SigV4-signed)
MTDI_S3_ACCESS_KEY_ID=
MTDI_S3_SECRET_ACCESS_KEY=
MTDI_S3_REGION=          # us-east-1 by default; "auto" for R2
MTDI_S3_ENDPOINT=        # e.g. https://<account>.r2.cloudflarestorage.com or http://localhost:9000
MTDI_STORAGE_KEY=        # 64 hex chars: client-side AES-256-GCM encryption (store --encrypt)

# ── Project wizard integrations (python -m mtdi create / publish)
GITHUB_TOKEN=            # or sign in with `gh auth login` instead
VERCEL_TOKEN=            # https://vercel.com/account/tokens
VERCEL_TEAM_ID=          # only for a Vercel team
NOTION_TOKEN=            # an internal integration: https://www.notion.so/my-integrations
NOTION_PARENT_PAGE_ID=   # a page shared with that integration (32-character id from its URL)
